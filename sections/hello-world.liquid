
<div style="text-align: {{section.settings.text_aligment}};">
  {%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'title' -%}
      <h2 style="background-color: {{block.settings.bg_color}}; color : {{block.settings.font_color}};" >TITLE</h2>
    {%- when 'subtitle' -%}
      <h5 style="background-color: {{block.settings.bg_color}}; color : {{block.settings.font_color}};">SUBTITLE</h5>
  {%- endcase -%}
{%- endfor -%}
</div>








{% schema %}
{
  "name": "hello woeld",
  "settings": [
    {
      "type": "select",
      "id": "text_aligment",
      "label": "Text Aligment",
      "info": "algin the text in center",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
        
      ]
      
    }
    ],
    "blocks": [
      {
        "name": "Title",
        "type": "title",
        "settings": [
           {
      "type": "color",
      "id": "bg_color",
      "label": "background color",
      "default": "#e9e9e9"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color",
      "default": "#ffffff"
    }
        ]
      },
      {
        "name": "Subtitle",
        "type": "subtitle",
        "settings": [
          {
      "type": "color",
      "id": "bg_color",
      "label": "background color",
      "default": "#e9e9e9"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color",
      "default": "#ffffff"
    }
        ]
        
      }
    ],
    "presets": [
      {
        "name": "hello world",
        "settings": {
          
        }
      }
    ]
}
{% endschema %}