
{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'title' -%}
      <h2 class="color">TITLE</h2>
    {%- when 'subtitle' -%}
      <h5>SUBTITLE</h5>
  {%- endcase -%}
{%- endfor -%}

{%- style -%}
  h2{
    back-ground: {{section.settings.bg_color}};
  }
{%- endstyle -%}





